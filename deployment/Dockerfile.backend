# ==============================================================================
# Multi-Stage Production Dockerfile for KIBO360 Backend API
# ==============================================================================

# Stage 1: Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY backend/package*.json ./
RUN npm ci

# Copy backend source and tsconfig
COPY backend/ ./

# Compile TypeScript
RUN npm run build

# Stage 2: Minimal Production Runtime
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Install curl/wget for healthchecks and dumb-init for proper signal handling
RUN apk add --no-cache dumb-init wget curl

# Copy production package specifications and install only production dependencies
COPY backend/package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy compiled code from builder stage
COPY --from=builder /app/dist ./dist

# Create non-root system user for security
RUN addgroup -S kibo && adduser -S kibo -G kibo
RUN chown -R kibo:kibo /app

USER kibo

EXPOSE 5000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/server.js"]
