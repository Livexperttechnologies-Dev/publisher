# ==============================================================================
# KIBO360 ENTERPRISE ERP - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production and populate secure secrets prior to deployment
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=5000
APP_NAME="KIBO360 Financial ERP"
APP_DOMAIN=erp.kibo360.com
CORS_ORIGIN=https://erp.kibo360.com

# PostgreSQL Primary Database Connection
DATABASE_URL=postgresql://kibo_admin:SecretProdP@ss2026@postgres:5432/kibo360_prod?sslmode=prefer
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kibo360_prod
DB_USER=kibo_admin
DB_PASSWORD=SecretProdP@ss2026
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000

# Redis Cache & Session Store
REDIS_URL=redis://:SecretRedisP@ss2026@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SecretRedisP@ss2026

# Cryptographic Authentication & JWT Secret Keys
JWT_SECRET=kibo360_enterprise_prod_jwt_secret_2026_replace_with_64char_random_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# File Storage & Upload Security
UPLOAD_DIR=/var/kibo360/uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Backup Encryption & Disaster Recovery
BACKUP_DIR=/var/kibo360/backups
BACKUP_ENCRYPTION_KEY=replace_with_aes_256_master_key_minimum_32_bytes_length
AWS_S3_BACKUP_BUCKET=kibo360-disaster-recovery-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Indian Taxation & E-Invoicing Credentials (NIC / IRP API)
GST_PORTAL_CLIENT_ID=
GST_PORTAL_CLIENT_SECRET=
EWAY_BILL_USERNAME=
EWAY_BILL_PASSWORD=

# Transactional Communication Gateways
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kibo360.com
MSG91_AUTH_KEY=
MSG91_DLT_TE_ID=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment Gateway Integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
